# Environment for `teleocr serve` / `parse` / `run` (copy to .env or export).
# Command-line options take precedence over these variables.
# No secret is needed: the model is a local file.

# GGUF model file (from `teleocr convert` or rleo/TeleOCR-GGUF) or a Hugging Face directory
TELEOCR_MODEL=models/teleocr-q8v.gguf
# Run on the CPU even when a GPU is available (use teleocr-q8_0.gguf there)
# TELEOCR_CPU=true
# CPU threads (default: all cores)
# TELEOCR_THREADS=16
# Pixels an image is resized to at most before the vision tower (model default 12845056)
# TELEOCR_MAX_PIXELS=12845056
# Document parsing: larger pages are downscaled before cropping blocks
TELEOCR_MAX_PAGE_PIXELS=4500000
# KV cache positions per decoding batch (16384 = 3.7 GB of F32 cache)
TELEOCR_KV_BUDGET=16384
# Server
TELEOCR_HOST=127.0.0.1
TELEOCR_PORT=8090
TELEOCR_MODEL_ID=teleocr
# Sequences decoded together when parsing (memory grows with it)
TELEOCR_BATCH=8
# Directory holding libpdfium.so / libpdfium.dylib / pdfium.dll (default: next to the binary)
# PDFIUM_LIB_PATH=/opt/pdfium/lib
# Log level
RUST_LOG=info
